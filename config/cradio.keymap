// Ferris Sweep keymap, ported from the BM43 layout in ~/qmk_userspace. Mac only.
// Key positions: left hand 0-4, 10-14, 20-24; right hand 5-9, 15-19, 25-29; thumbs 30-33.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE  0
#define SYM   1
#define NAV   2
#define MEDIA 3
#define FN    4

#define LEFT_HAND  0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define RIGHT_HAND 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS     30 31 32 33

/ {
    behaviors {
        // Home row mods. A mod only counts when the next key is on the other hand or a thumb,
        // and never right after a letter, so fast typing stays letters.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <RIGHT_HAND THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <LEFT_HAND THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Backspace/Symbols. Nothing rolls off this key in normal typing, so any key pressed
        // while it's down is a symbol, even if the thumb lifts first.
        bs_sym: backspace_symbols {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            bindings = <&mo>, <&kp>;
        };
        // Space/Nav. Only a full hold opens Nav. Letters pressed sooner stay letters, because a
        // letter landing inside a Space press is normal fast typing.
        sp_nav: space_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <100>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
        tab_med: tab_media {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
        esc_sft: esc_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    // Base layer only, on pairs with no sideways stretch.
    combos {
        compatible = "zmk,combos";

        combo_lpar {
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
            key-positions = <12 13>;     // D F
            layers = <BASE>;
            bindings = <&kp LPAR>;
        };
        combo_rpar {
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
            key-positions = <16 17>;     // J K
            layers = <BASE>;
            bindings = <&kp RPAR>;
        };
        combo_dquote {
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
            key-positions = <13 16>;     // F J
            layers = <BASE>;
            bindings = <&kp DQT>;
        };
        combo_underscore {
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
            key-positions = <12 17>;     // D K
            layers = <BASE>;
            bindings = <&kp UNDER>;
        };
        combo_colon {
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
            key-positions = <17 18>;     // K L
            layers = <BASE>;
            bindings = <&kp COLON>;
        };
        // Bottom-row pairs that almost never come up in typing, on keys with no hold function.
        // A combo stays pressed while both keys are down, so this Backspace repeats when held.
        combo_backspace {
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
            key-positions = <27 28>;     // , .
            layers = <BASE>;
            bindings = <&kp BSPC>;
        };
        combo_minus {
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
            key-positions = <22 23>;     // C V
            layers = <BASE>;
            bindings = <&kp MINUS>;
        };
        combo_apostrophe {
            timeout-ms = <40>;
            require-prior-idle-ms = <50>;
            key-positions = <22 27>;     // C ,
            layers = <BASE>;
            bindings = <&kp SQT>;
        };
    };

    // Both inner thumbs, in either order, give Fn.
    conditional_layers {
        compatible = "zmk,conditional-layers";
        fn_layer {
            if-layers = <SYM NAV>;
            then-layer = <FN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
            &kp Q         &kp W         &kp E         &kp R      &kp T          &kp Y      &kp U      &kp I         &kp O         &kp P
            &hml LCTRL A  &hml LALT S   &hml LGUI D   &kp F      &kp G          &kp H      &kp J      &hmr RGUI K   &hmr RALT L   &hmr RCTRL ENTER
            &kp Z         &kp X         &kp C         &kp V      &kp B          &kp N      &kp M      &kp COMMA     &kp DOT       &kp FSLH
                                &tab_med MEDIA TAB  &bs_sym SYM BSPC            &sp_nav NAV SPACE  &esc_sft LSHFT ESC
            >;
        };

        // Hold left inner thumb. Right inner stays Space/Nav so a Space hit while still holding
        // Symbols can't delete anything, and holding it gives Fn. Backspace moves to right outer.
        symbol_layer {
            display-name = "Symbols";
            bindings = <
            &kp N1     &kp N2     &kp N3     &kp N4     &kp N5          &kp N6     &kp N7     &kp N8     &kp N9     &kp N0
            &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT       &kp CARET  &kp AMPS   &kp ASTRK  &kp SEMI   &kp SQT
            &kp BSLH   &kp PIPE   &kp MINUS  &kp EQUAL  &kp UNDER       &kp PLUS   &kp LBRC   &kp RBRC   &kp LBKT   &kp RBKT
                                  &none      &trans                     &trans     &kp BSPC
            >;
        };

        // Hold right inner thumb. Arrows on the right hand, modifiers under the left.
        // Left inner stays Backspace/Symbols, and holding it gives Fn.
        nav_layer {
            display-name = "Nav";
            bindings = <
            &kp LS(LG(LBKT))  &kp LS(LG(RBKT))  &kp TILDE  &kp GRAVE  &none          &kp LA(LEFT)  &kp PG_DN     &kp PG_UP    &kp LA(RIGHT)  &kp DEL
            &kp LCTRL         &kp LALT          &kp LGUI   &kp LSHFT  &caps_word     &kp LEFT      &kp DOWN      &kp UP       &kp RIGHT      &trans
            &kp LG(Z)         &kp LG(X)         &kp LG(C)  &kp LG(V)  &kp LS(LG(Z))  &kp LG(LEFT)  &kp LG(RIGHT) &kp LG(UP)   &kp LG(DOWN)   &trans
                                                &kp LA(BSPC)  &trans                 &trans        &none
            >;
        };

        // Hold left outer thumb. Media on the left, numpad on the right. Shot copies a screen
        // selection to the clipboard.
        media_layer {
            display-name = "Media";
            bindings = <
            &none      &kp C_VOL_UP  &kp C_BRI_UP  &kp LC(LS(LG(N4)))  &none          &kp FSLH   &kp N7     &kp N8     &kp N9     &kp PLUS
            &kp C_PREV &kp C_PP      &kp C_NEXT    &kp C_MUTE          &kp BSPC       &kp ASTRK  &kp N4     &kp N5     &kp N6     &trans
            &none      &kp C_VOL_DN  &kp C_BRI_DN  &none               &none          &kp MINUS  &kp N1     &kp N2     &kp N3     &kp EQUAL
                                     &trans        &none                              &kp N0     &kp DOT
            >;
        };

        // Both inner thumbs. Bootloader keys only affect the half they're pressed on, so each
        // half has its own.
        fn_layer {
            display-name = "Fn";
            bindings = <
            &kp F1       &kp F2        &kp F3        &kp F4        &kp F5         &kp F6       &kp F7          &kp F8     &kp F9     &kp F10
            &kp C_VOL_DN &kp C_VOL_UP  &kp C_MUTE    &kp C_PP      &none          &kp C_PREV   &kp C_NEXT      &none      &kp F11    &kp F12
            &bootloader  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR     &out OUT_TOG &studio_unlock  &none      &none      &bootloader
                                       &none         &trans                       &trans       &none
            >;
        };
    };
};
